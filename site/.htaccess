# Was auf dem alten Host die Caddy-Konfiguration erledigte.
# ⚠️ BEWUSST KURZ: ein langer Header (insbesondere eine ausfuehrliche
# Content-Security-Policy) laesst den Apache dieses Shared Hostings mit 500 aussteigen.
# Das ist hier schon einmal passiert; die Regel steht deshalb im Vault.

# install.sh soll im Browser LESBAR sein, nicht heruntergeladen werden — wer ein Skript
# in seine Shell pipen soll, muss es vorher ansehen koennen.
<FilesMatch "\.sh$">
  ForceType text/plain
</FilesMatch>

# dossier.html ist in die Startseite aufgegangen (#ledger, #myth, #limits).
# Ein Fragment kann nicht in einer 301 mitreisen — mod_alias wuerde das # kodieren —
# deshalb zeigt die Weiterleitung auf /; die Anker leben dort.
Redirect 301 /dossier.html /

# .gz ist hier ein ARCHIVFORMAT, keine Transportkodierung. Der Apache dieses Hostings
# haengt an .gz per Voreinstellung `Content-Encoding: x-gzip` — ein Client, der das
# auswertet (curl --compressed, Python requests, jeder Browser), entpackt beim Empfang
# und haelt dann ein rohes Tar mit anderem SHA-256 in der Hand als das, was .sha256 und
# .sig beschreiben. Gemessen am 2026-09-02 im Review der llmman-Integration. Ohne
# Kodierung bekommt jeder Client dieselben Bytes wie der Installer (curl ohne
# --compressed) und der Updater (urllib), die nie betroffen waren.
RemoveEncoding .gz .tgz
AddType application/gzip .gz .tgz

# Der Quell-Tarball ist erreichbar, gehoert aber in keinen Suchindex.
<IfModule mod_headers.c>
  <FilesMatch "\.(tar\.gz|sig|sha256)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# Schriften sind unveraenderlich benannt und duerfen lange liegen bleiben.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
