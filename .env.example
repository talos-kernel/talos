# Talos configuration. Copy to ~/.secrets/talos-telegram.env and chmod 600.
# Nothing here belongs in the repository.

# --- required -----------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Who may command this agent. Format: <channel>:<id>, space or comma separated.
# There is no default. Leave this empty and the agent refuses to start — a shipped
# default would be a backdoor printed in the source.
# Find your Telegram id by messaging @userinfobot.
TALOS_ALLOWED_PRINCIPALS=telegram:000000000

# --- optional -----------------------------------------------------------------
# Shown in the greeting; purely cosmetic.
TELEGRAM_BOT_USERNAME=

# Set to 1 to make every shell command ask for approval again (pre-Guardian-Mode
# behaviour). Useful while you are still reading the code.
TALOS_SHELL_NEEDS_HUMAN=0

# Path to a markdown knowledge base the agent may search and write notes into.
# Leave unset to disable the vault tools entirely.
TALOS_VAULT_DIR=

# Binary used for full-text search inside the vault.
TALOS_QMD_BIN=

# --- how it thinks --------------------------------------------------------------
# Which provider and model. `talos models` lists what this installation knows;
# `talos setup model` walks you through it and proves the key before writing it.
TALOS_MODEL_PROVIDER=anthropic-api
TALOS_MODEL=claude-opus-5

# Your own API key. One per provider — there is deliberately no single key that
# serves every provider: selecting one provider must never send another's key.
# Only the key of the SELECTED provider is ever used; if it is missing, the agent
# refuses that provider instead of substituting a different one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: a custom endpoint, bound to its provider. The name carries the slug —
# TALOS_BASE_URL_OPENAI_API, TALOS_BASE_URL_ANTHROPIC_API, and so on.
# There is no provider-less base url: one address for every provider is how a key
# ends up at the wrong company.
TALOS_BASE_URL_OPENAI_API=

# Optional: a runtime fallback chain, tried in order when a run fails with a
# classified error (rejected key, quota, overload, network, timeout — never a
# factual 4xx). Comma-separated provider/model specs. Local providers like ollama
# need no key. The persisted model choice is never touched; the next run starts
# with the primary again.
# TALOS_MODEL_FALLBACKS=ollama/qwen3:27b,nvidia-nim/meta/llama-3.3-70b-instruct

# Correct what the catalog does not know about a model — context window (tokens),
# list prices (USD per million tokens), vision/reasoning flags — without touching the
# catalog. One JSON object on ONE line, keyed by model id. Unknown ids and fields are
# dropped with a warning (event log, `talos doctor`, `talos models`); broken JSON stops
# the start. Never a provider, url or key: an override corrects numbers, not routes.
# TALOS_MODEL_OVERRIDES={"claude-opus-5": {"context_window": 200000, "input_price": 15, "output_price": 75, "vision": true}}

# --- mail channel (optional) ----------------------------------------------------
# Mail is a second way IN, fetched over IMAP. All three are required or the
# channel does not exist.
TALOS_MAIL_HOST=
TALOS_MAIL_USER=
TALOS_MAIL_PASSWORD=
# Host for replies, if it differs from the IMAP host.
TALOS_MAIL_SMTP_HOST=

# The name YOUR receiving server stamps into Authentication-Results.
# ⚠️ Without it every mail is discarded, on purpose: a From: line is written by the
# sender, and so is any Authentication-Results header nobody can attribute to a
# server. Talos trusts only the topmost header carrying this exact name.
TALOS_MAIL_AUTHSERV_ID=

# --- search (optional) ----------------------------------------------------------
# Without a key the keyless provider answers; there is no guessed substitute.
TALOS_BRAVE_API_KEY=

# --- claude worker (optional) ---------------------------------------------------
# Optional Codex backend, using the same confined worker socket:
# TALOS_CODEX_BACKEND=1
# Worker service only (CODEX_HOME directory with auth.json; never copy config):
# TALOS_CLAUDE_WORKER_CODEX_BIN=/usr/bin/codex
# TALOS_CLAUDE_WORKER_CODEX_HOME=/var/lib/talos/codex-home
# TALOS_CLAUDE_WORKER_CODEX_MODEL=<operator-chosen-model>
# Delegate bounded coding jobs to a local, confined Claude worker
# (delegate_code / delegate_status). Default off; see docs/claude-worker.md.
# NOTE: ENABLED/SOCKET/ROOT must live in the agent's PROCESS environment
# (its service unit's Environment= lines), not only in a secrets file — the
# kernel checks os.environ itself, like TALOS_MODEL_WORKER.
# Master switch for the delegation tools.
# TALOS_CLAUDE_WORKER_ENABLED=0
# Unix socket of the Claude worker — changing it redirects delegated jobs.
# TALOS_CLAUDE_WORKER_SOCKET=
# Root directory for job workspaces; jobs may write only below it.
# TALOS_CLAUDE_WORKER_ROOT=
# Dedicated HOME for Claude jobs holding only the Claude OAuth state.
# TALOS_CLAUDE_WORKER_HOME=
# Pinned claude binary path for worker jobs.
# TALOS_CLAUDE_WORKER_BIN=claude
# Max concurrent Claude worker jobs.
# TALOS_CLAUDE_WORKER_MAX_PARALLEL=2
# Overall deadline per Claude job in seconds.
# TALOS_CLAUDE_WORKER_JOB_TIMEOUT=900
