# Runtime data — contains the audit log with recorded commands, plus snapshots.
# Never commit this.
data/

# Operator-owned prompt state einer Installation (deployment-eigen, wie SOUL.md
# auf dem Ziel). Wer sie hier anlegt, darf sie nie committen — sie werden sonst
# mitveroeffentlicht. Das Repo liefert bewusst keine davon aus.
/AGENTS.md
/USER.md
/MEMORY.md

# Der freie Arbeitsbereich des Agenten (`policy.WORKSPACE_DIR`) — Laufzeitzustand,
# den der Updater unter STATE_PATHS mitnimmt. Dort landen auch eingehende Fotos
# und Standbilder aus Videos.
workspace/

# Environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Secrets live outside the repo (~/.secrets/talos-telegram.env, mode 600).
# These patterns are a second line of defence, not the primary one.
*.env
!.env.example
.secrets/

# Editor / OS noise
.DS_Store
*.swp

# Release-Tarballs werden lokal gebaut, nie committed — alte Staende darin enthalten
# veraltete Doku, die nicht unter einer neuen Versionsnummer raus darf.
dist/

# Die Betriebs-Skripte selbst sind generisch und getrackt; die privaten Ziele
# (Hostnamen/Pfade der privaten Instanz) leben in *.local-Ueberschreibungen,
# die nicht in den Baum gehoeren, aus dem sync-public.sh das oeffentliche Repo fuellt.
scripts/*.local
backups/
